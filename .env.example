ENVIRONMENT=local

# SQLite (default, zero-setup). Stored in instance/ so it maps to a named Docker
# volume (batikdata:/app/instance) and persists across container recreations.
# To use PostgreSQL instead, set the postgresql+asyncpg URL (e.g. via
# `docker compose -f docker/docker-compose.yml --profile postgres up -d db`):
# DATABASE_URL=postgresql+asyncpg://tuban:tuban@localhost:5432/tuban
DATABASE_URL=sqlite+aiosqlite:///./instance/tuban.db

# Set this to the email granted admin rights on first login. Leave empty for none.
INITIAL_ADMIN_EMAIL=admin@example.com

# Auth (AUTH_ prefix)
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
AUTH_SECURE_COOKIES=false

# Generate a strong secret with: python -c "import secrets;print(secrets.token_urlsafe(64))"
AUTH_SESSION_SECRET=change-me-in-production-change-me-in-production
AUTH_SESSION_EXP_MINUTES=480

# Dev login (email) is hardcoded to ENVIRONMENT=local only — never set in
# staging/production.

# Storage (STORAGE_ prefix)
STORAGE_BACKEND=local
STORAGE_UPLOAD_MAX_SIZE=20971520

# S3-compatible storage using standard AWS env vars (MinIO locally, AWS S3 in
# staging/production). STORAGE_AWS_ENDPOINT_URL points at MinIO when not using real S3.
STORAGE_AWS_ACCESS_KEY_ID=minioadmin
STORAGE_AWS_SECRET_ACCESS_KEY=minioadmin
STORAGE_AWS_DEFAULT_REGION=us-east-1
STORAGE_AWS_ENDPOINT_URL=http://localhost:9000
STORAGE_AWS_S3_BUCKET=batik
